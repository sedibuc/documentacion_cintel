@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam rectangle {
  BackgroundColor #f0f4ff
  BorderColor #4466aa
  FontSize 11
}
skinparam note {
  BackgroundColor #fffbe6
  BorderColor #ccaa00
}
left to right direction

rectangle "Sprint 0\n2026-07-01 a 07-14\nAmbientes, CI/CD, seguridad\nEntorno LLM, modelo base\nContrato API interna IA" as s0

rectangle "Sprint 1\n2026-07-15 a 07-28\nMulti-tenant, RBAC, onboarding\nProototipo LLM, prompts v1\nEsquema JSON/CSV inicial" as s1

rectangle "Sprint 2\n2026-07-29 a 08-11\nPipeline ingesta, APIs REST\nExtraccion estructurada\nJSON/CSV validado" as s2

rectangle "Sprint 3\n2026-08-12 a 08-25\nValidationEngine, DiscrepancyAlert\nCrossValidator, MATCH/MISMATCH\nAPI IA v1 expuesta" as s3

note bottom of s3 : Hito 2: modulo IA\nconsumible por sistema\ntradicional

rectangle "Sprint 4\n2026-08-26 a 09-08\nUI revision, batch, historial\nRefinamiento prompts\nOptimizacion LLM" as s4

rectangle "Sprint 5\n2026-09-09 a 09-22\nAudit Service, trazas\nMetricas operativas, REST\nCalidad LLM, aislamiento" as s5

rectangle "Sprint 6\n2026-09-23 a 10-06\nE2E, carga, seguridad\nUAT tenant piloto\nSalida controlada" as s6

s0 --> s1
s1 --> s2
s2 --> s3
s3 --> s4
s4 --> s5
s5 --> s6
@enduml