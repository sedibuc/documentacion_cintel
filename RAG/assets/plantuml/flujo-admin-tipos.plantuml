@startuml flujo-admin-tipos
skinparam backgroundColor #f7f1e7
skinparam activity {
  BackgroundColor #ffffff
  BorderColor #0f5a58
  BorderThickness 1.5
  FontSize 13
  FontName "Segoe UI"
  ArrowColor #0f5a58
  ArrowFontSize 11
  StartColor #0f5a58
  EndColor #073534
  DiamondBackgroundColor #d6ebe8
  DiamondBorderColor #0f5a58
}
skinparam note {
  BackgroundColor #d6ebe8
  BorderColor #0f5a58
}
skinparam title {
  FontSize 16
  FontStyle bold
  FontColor #073534
}

title Flujo 6 — Administración de tipo documental

start
:Administrador crea nuevo tipo documental\n(nombre, descripción, sector);
:Define campos a extraer\n(nombre, tipo de dato, descripción semántica, requerido / opcional);
:Define esquema de salida\n(JSON, CSV o ambos) y reglas de validación;
:Estado inicial: EN DESARROLLO\n(no visible para empresas);
note right
  EN DESARROLLO:
  solo uso interno del equipo.
  No disponible para empresas.
end note

note right
  MVP LLM-first:
  no requiere dataset anotado
  ni entrenamiento NER.
end note

:Equipo carga documentos de validación\nrepresentativos del tipo;

repeat
  :Ejecuta extracción LLM de prueba\ncon esquema + prompt base;
  :Equipo revisa completitud, confianza\ny corrige esquema o prompt;
repeat while (¿Precisión aceptable?) is (No)
->Sí;

:Equipo promueve tipo a estado BETA;
note right
  BETA:
  visible para empresas con
  advertencia de variabilidad.
  Sin garantía de precisión.
end note

:Empresas piloto usan el tipo\ny reportan errores o ajustes;

repeat
  :Equipo ajusta esquema, prompt o umbrales\ny revalida con nuevos documentos;
repeat while (¿Listo para PRODUCCIÓN?) is (No)
->Sí;

:Equipo promueve tipo a PRODUCCIÓN;
note right
  PRODUCCIÓN:
  validado y confiable.
  Recomendado para operación regular.
end note

:Tipo documental disponible\npara todas las empresas habilitadas;
stop

@enduml
