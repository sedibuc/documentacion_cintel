@startuml agente-creativo-fases
skinparam backgroundColor #1a202c
skinparam defaultFontColor #d4dae6
skinparam defaultFontName "Segoe UI"
skinparam activityBackgroundColor #1e2533
skinparam activityBorderColor #4db8b5
skinparam activityFontColor #e8f4f3
skinparam arrowColor #4db8b5
skinparam noteBackgroundColor #252d3d
skinparam noteBorderColor #4db8b5
skinparam noteFontColor #9ba5b4
skinparam partitionBackgroundColor #161b27
skinparam partitionBorderColor #4db8b5

title Agente Creativo — Sistema multi-agente (orquestador + canales especializados)

|Agente Estratégico|
start
:Genera plan de campaña estructurado;
note right
  Objetivo, audiencia,
  canales, mensaje,
  campaña base
end note
:Envía plan al Agente Creativo;

|CreativeAgent (Orquestador)|
:** FASE 1 — BRIEF DE DISEÑO **;
:Recibe el plan estratégico;
:Consulta BrandGuidelinesStore;
note right
  Tono ponderado,
  blacklist/whitelist,
  restricciones de marca
end note
:Construye brief creativo por canal;
note right
  Nombre, objetivo, audiencia,
  mensaje, tono, canal, CTA,
  tipo de pieza, restricciones
end note
:Presenta brief al usuario;
if (¿Usuario aprueba el brief?) then (Sí — o ajusta)
  :Brief confirmado;
else (No — solicita revisión)
  :Usuario edita parámetros del brief;
  :Brief actualizado;
endif

:** FASE 2 — PRODUCCIÓN MULTICANAL (paralela) **;
fork
  |LinkedInAgent|
  :Recibe brief;
  :Aplica mejores prácticas LinkedIn;
  note right
    Longitud óptima 150–300 palabras,
    hashtags profesionales,
    estructura hook-cuerpo-CTA
  end note
  :Genera pieza LinkedIn;
fork again
  |InstagramAgent|
  :Recibe brief;
  :Aplica mejores prácticas Instagram;
  note right
    Visual-first, caption breve,
    hashtags engagement,
    stories / reels
  end note
  :Genera pieza Instagram;
fork again
  |EmailAgent|
  :Recibe brief;
  :Aplica mejores prácticas Email;
  note right
    Asunto + preheader + cuerpo + CTA,
    evitar spam triggers,
    plantillas aprobadas
  end note
  :Genera pieza Email;
fork again
  |WhatsAppAgent|
  :Recibe brief;
  :Aplica mejores prácticas WhatsApp;
  note right
    Brevedad máxima,
    tono conversacional,
    plantillas aprobadas HSM
  end note
  :Genera pieza WhatsApp;
end fork

|CreativeAgent (Orquestador)|
:** FASE 3 — EVALUACIÓN Y ENTREGA **;
:CriticAgent evalúa alineación institucional;
note right
  Verifica tono, blacklist/whitelist,
  restricciones de marca. Asigna
  score de alineación por pieza.
end note
if (¿Todas las piezas superan umbral?) then (Sí)
  :Consolida piezas aprobadas;
else (Alguna pieza requiere ajuste)
  :Feedback al agente de canal correspondiente;
  :Re-generación dirigida;
  :Consolida piezas re-generadas;
endif
:Presenta piezas al usuario para revisión humana;
if (¿Pieza aprobada?) then (Sí)
  :Pieza lista para publicar / exportar;
else (Ajustar)
  :Usuario da instrucción de ajuste;
  :Agente de canal genera versión revisada;
endif

|Canal de publicación|
:Usuario publica la pieza;
if (¿Canal es Instagram?) then (Sí)
  :Registra link de publicación;
  :Sistema consulta métricas automáticamente;
  :Panel de resultados actualizado;
else (Otro canal)
  :Usuario carga resultados manualmente;
  note right
    Excel / CSV
  end note
  :Resultados asociados a la pieza;
endif

stop
@enduml
